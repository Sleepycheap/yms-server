<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <h1 class="title"><%= title %></h1>
    <h2 class="user">Hello <%= user %></h2>

    <div class="scacList">
      <h1>Scac List</h1>
      <table>
        <thead>
          <tr>
            <th>Scac Code</th>
          </tr>
        </thead>
        <tbody>
          <% for (let i = 0; i < scacList.length; i++) { %>
            <td>
              <%= scacList[i][0] %>
            </td>
         <% }; %> 
        </tbody>
      </table>
    </div>
